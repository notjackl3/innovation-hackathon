DATABASE_URL="file:./dev.db"

# AI providers — leave blank to use deterministic mock outputs
OPENAI_API_KEY=
MESHY_API_KEY=

# Set to "true" to force mock mode even if keys are present (useful for tests)
MOCK_AI=false

# Storage (dev uses local FS rooted at ./storage; prod uses Vercel Blob)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Optional video upgrade providers
RUNWAY_API_KEY=
LUMA_API_KEY=

# Image-to-video (Seedance) — default provider is OpenRouter. Get a key at
# https://openrouter.ai/settings/keys. Double-underscore variants are the
# user's preferred convention; single-underscore variants also accepted.
OPENROUTER__API_KEY=
OPENROUTER__VIDEO_MODEL=bytedance/seedance-2.0
SEEDANCE_PROVIDER=openrouter

# Or use Replicate instead:
# SEEDANCE_PROVIDER=replicate
# REPLICATE_API_TOKEN=

# Renderer service (Phase 4b deepen). Optional — falls back to in-browser preview only.
RENDERER_URL=
